[Unit]
Description=Alertmanager to Google Chat Webhook Relay
After=network-online.target prometheus-alertmanager.service
Wants=network-online.target

[Service]
Type=simple
User=prometheus
Environment="GCHAT_WEBHOOK_URL={{ alertmanager_google_chat_webhook_url }}"
Environment="PORT={{ alertmanager_google_chat_relay_port | default(5001) }}"
ExecStart=/usr/local/bin/alertmanager-google-chat-relay {{ alertmanager_google_chat_relay_port | default(5001) }}
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
