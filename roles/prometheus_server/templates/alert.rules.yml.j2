# ==============================================================================
# Prometheus Alerting Rules - Managed by Ansible
# Validated with `promtool check rules` during deployment
# ==============================================================================

groups:
  - name: haproxy_cluster_alerts
    rules:
      - alert: HAProxyBackendServerDown
        expr: haproxy_server_status != 1
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "HAProxy backend server down (instance {{ $labels.instance }})"
          description: "Backend {{ $labels.proxy }} on server {{ $labels.server }} is reporting DOWN status."

      - alert: HAProxyHigh5xxErrorRate
        expr: sum(rate(haproxy_server_http_responses_total{code="5xx"}[5m])) / sum(rate(haproxy_server_http_responses_total[5m])) * 100 > 5
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "HAProxy elevated 5xx error rate"
          description: "Over 5% of responses from backend {{ $labels.proxy }} are HTTP 5xx errors for more than 5 minutes."

      - alert: HAProxyRateLimitSaturationSpike
        expr: increase(haproxy_frontend_denied_requests_total[5m]) > 50
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "HAProxy rate limit saturation spike"
          description: "HAProxy has denied over 50 client requests under the 300req/10s volumetric rate limiter in the last 5 minutes."

      - alert: ClusterNodeUnreachable
        expr: up == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Cluster monitoring target unreachable (instance {{ $labels.instance }})"
          description: "Scrape job {{ $labels.job }} target {{ $labels.instance }} has been unreachable for > 2 minutes."

      - alert: InternalTLSCertificateExpiringSoon
        expr: (x509_cert_expiry_timestamp_seconds - time()) / 86400 < 14
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "Internal TLS certificate expiring soon on {{ $labels.instance }}"
          description: "Internal certificate {{ $labels.cert_name }} at {{ $labels.cert_path }} (role: {{ $labels.role }}) on host {{ $labels.instance }} expires in less than 14 days. Verify that automated renewal is progressing."

      - alert: InternalTLSCertificateExpirationCritical
        expr: (x509_cert_expiry_timestamp_seconds - time()) / 86400 < 3
        for: 15m
        labels:
          severity: critical
        annotations:
          summary: "CRITICAL: Internal TLS certificate expiring in < 3 days on {{ $labels.instance }}"
          description: "Internal certificate {{ $labels.cert_name }} at {{ $labels.cert_path }} (role: {{ $labels.role }}) on host {{ $labels.instance }} expires in less than 3 days! Immediate automated renewal intervention required."

      - alert: HostMemoryAvailableLow
        expr: (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100 < 10
        for: 3m
        labels:
          severity: warning
        annotations:
          summary: "Low available host memory on {{ $labels.instance }}"
          description: "Host {{ $labels.instance }} has less than 10% memory available for more than 3 minutes. Consider scaling up instance tier."

      - alert: RabbitMQMemoryAlarmActive
        expr: rabbitmq_alarms_memory_used_watermark == 1
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "RabbitMQ memory alarm active on {{ $labels.instance }}"
          description: "RabbitMQ node {{ $labels.instance }} exceeded its memory high watermark; incoming message publishers are blocked."

      - alert: RabbitMQDiskFreeAlarmActive
        expr: rabbitmq_alarms_free_disk_space_watermark == 1
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "RabbitMQ disk space alarm active on {{ $labels.instance }}"
          description: "RabbitMQ node {{ $labels.instance }} fell below its disk free space limit; incoming message publishers are blocked."

      - alert: RabbitMQQueueBacklogHigh
        expr: rabbitmq_queue_messages_ready > 5000
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "RabbitMQ queue backlog elevated on {{ $labels.instance }}"
          description: "Queue {{ $labels.queue }} on vhost {{ $labels.vhost }} has more than 5,000 ready messages pending worker consumption."

      - alert: HostDiskSpaceLow
        expr: (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"}) * 100 < 15
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Low disk space on {{ $labels.instance }} (mount {{ $labels.mountpoint }})"
          description: "Filesystem mounted at {{ $labels.mountpoint }} on host {{ $labels.instance }} has less than 15% free disk space remaining."

      - alert: HostDiskSpaceCritical
        expr: (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"}) * 100 < 5
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "CRITICAL: Dangerous disk space exhaustion on {{ $labels.instance }} (mount {{ $labels.mountpoint }})"
          description: "Filesystem mounted at {{ $labels.mountpoint }} on host {{ $labels.instance }} has less than 5% free disk space remaining! Immediate triage or volume expansion required."
