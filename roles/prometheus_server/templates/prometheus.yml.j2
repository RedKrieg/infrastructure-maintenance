# ==============================================================================
# Prometheus Configuration - Managed by Ansible
# ==============================================================================

global:
  scrape_interval: {{ prometheus_scrape_interval | default('15s') }}
  evaluation_interval: {{ prometheus_evaluation_interval | default('15s') }}
  scrape_timeout: 10s

{% if prometheus_enable_alerts | default(true) | bool %}
# Alerting Configuration & Rule Files
rule_files:
  - "{{ prometheus_alert_rules_file | default('/etc/prometheus/alert.rules.yml') }}"

{% if prometheus_alertmanager_enabled | default(false) | bool %}
alerting:
  alertmanagers:
    - static_configs:
        - targets:
{% for target in prometheus_alertmanager_targets | default(['127.0.0.1:9093']) %}
            - "{{ target }}"
{% endfor %}
{% endif %}
{% endif %}

scrape_configs:
{% if prometheus_scrape_self | bool %}
  # Scrape Prometheus Server Metrics
  - job_name: 'prometheus'
    metrics_path: /metrics
    static_configs:
      - targets: ['127.0.0.1:{{ prometheus_port | default(9090) }}']
        labels:
          role: 'monitoring'
{% endif %}

{% if prometheus_scrape_haproxy | bool and groups['proxies'] is defined and groups['proxies'] | length > 0 %}
  # Scrape Frontend HAProxy Cluster Nodes
  - job_name: 'haproxy'
    scrape_interval: {{ prometheus_scrape_interval | default('15s') }}
    metrics_path: {{ prometheus_haproxy_metrics_path | default('/metrics') }}
{% if admin_users is defined and admin_users | length > 0 %}
{% set first_admin = admin_users[0] %}
{% set auth_user = first_admin.name %}
{% set auth_pass = first_admin.service_password | default(first_admin.password | default(haproxy_stats_password | default(prometheus_haproxy_password))) %}
{% else %}
{% set sample_proxy = groups['proxies'][0] %}
{% set auth_user = hostvars[sample_proxy]['haproxy_stats_user'] | default(prometheus_haproxy_user) %}
{% set auth_pass = hostvars[sample_proxy]['haproxy_stats_password'] | default(prometheus_haproxy_password) %}
{% endif %}
{% if auth_user and auth_pass %}
    basic_auth:
      username: "{{ auth_user }}"
      password: "{{ auth_pass }}"
{% endif %}
    static_configs:
      - targets:
{% for host in groups['proxies'] %}
{% set target_ip = hostvars[host]['internal_ip'] | default(hostvars[host]['ansible_host'] | default(host)) %}
{% set target_port = hostvars[host]['haproxy_stats_port'] | default(prometheus_haproxy_port | default(8404)) %}
          - "{{ target_ip }}:{{ target_port }}"
{% endfor %}
        labels:
          role: 'loadbalancer'
          cluster: 'haproxy-proxies'
{% endif %}

{% if prometheus_scrape_node_exporter | default(true) | bool and groups['all'] is defined and groups['all'] | length > 0 %}
  # Scrape Node Exporter across all hosts
  - job_name: 'node_exporter'
    scrape_interval: {{ prometheus_scrape_interval | default('15s') }}
{% if enable_internal_tls | default(false) | bool or node_exporter_enable_tls | default(false) | bool %}
    scheme: https
    tls_config:
      ca_file: {{ prometheus_ca_file | default('/etc/ssl/certs/internal-ca.crt') }}
      cert_file: {{ prometheus_cert_file | default('/etc/ssl/internal/server.crt') }}
      key_file: {{ prometheus_key_file | default('/etc/ssl/internal/server.key') }}
      insecure_skip_verify: false
{% endif %}
    static_configs:
      - targets:
{% for host in groups['all'] %}
{% set target_ip = hostvars[host]['internal_ip'] | default(hostvars[host]['ansible_host'] | default(host)) %}
{% set target_port = hostvars[host]['node_exporter_port'] | default(prometheus_node_exporter_port | default(9100)) %}
          - "{{ target_ip }}:{{ target_port }}"
{% endfor %}
        labels:
          role: 'fleet'
{% endif %}

{% if groups['rabbitmq_servers'] is defined and groups['rabbitmq_servers'] | length > 0 %}
  # Scrape RabbitMQ Metrics (Prometheus Plugin)
  - job_name: 'rabbitmq'
    scrape_interval: {{ prometheus_scrape_interval | default('15s') }}
    metrics_path: /metrics
    static_configs:
      - targets:
{% for host in groups['rabbitmq_servers'] %}
{% set target_ip = hostvars[host]['internal_ip'] | default(hostvars[host]['ansible_host'] | default(host)) %}
{% set target_port = hostvars[host]['rabbitmq_prometheus_port'] | default(15692) %}
          - "{{ target_ip }}:{{ target_port }}"
{% endfor %}
        labels:
          role: 'message_broker'
{% endif %}

{% if prometheus_custom_scrape_configs is defined and prometheus_custom_scrape_configs | length > 0 %}
{{ prometheus_custom_scrape_configs | to_nice_yaml(indent=2) }}
{% endif %}
