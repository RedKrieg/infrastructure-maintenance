# ==============================================================================
# Grafana Dashboard Provisioning - Managed by Ansible
# ==============================================================================

apiVersion: 1

providers:
  - name: 'Default Provider'
    orgId: 1
    folder: ''
    type: file
    disableDeletion: false
    updateIntervalSeconds: 30
    allowUiUpdates: false
    options:
      path: {{ grafana_dashboards_dir | default('/var/lib/grafana/dashboards') }}
