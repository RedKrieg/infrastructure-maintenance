# ==============================================================================
# Grafana Datasource Provisioning - Managed by Ansible
# ==============================================================================

apiVersion: 1

datasources:
  - name: {{ grafana_prometheus_name | default('Prometheus') }}
    type: prometheus
    access: proxy
    url: {{ grafana_prometheus_url | default('http://127.0.0.1:9090') }}
    isDefault: true
    editable: false
    jsonData:
      timeInterval: "15s"
      httpMethod: POST
