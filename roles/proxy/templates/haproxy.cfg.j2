# ==============================================================================
# HAProxy Dynamic Configuration - Managed by Ansible
# SSL is terminated here; each external FQDN is dynamically mapped 1:1 to its webserver
# Shared certificates: HTTP-01 challenges forwarded to Primary with local backup failover
# ==============================================================================

global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    user {{ haproxy_user }}
    group {{ haproxy_group }}
    daemon
    maxconn {{ haproxy_maxconn }}
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    ca-base /etc/ssl/certs
    crt-base {{ haproxy_certs_dir }}

    # Modern SSL configuration
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect {{ haproxy_timeout_connect }}
    timeout client  {{ haproxy_timeout_client }}
    timeout server  {{ haproxy_timeout_server }}
    errorfile 400 /etc/haproxy/errors/400.http
    errorfile 403 /etc/haproxy/errors/403.http
    errorfile 404 /etc/haproxy/errors/404.http
    errorfile 500 /etc/haproxy/errors/500.http
    errorfile 502 /etc/haproxy/errors/502.http
    errorfile 503 /etc/haproxy/errors/503.http
    errorfile 504 /etc/haproxy/errors/504.http

{% if haproxy_enable_stats | bool %}
# --- HAProxy Statistics Web UI & Prometheus Metrics ---
listen stats
{% if haproxy_enable_dual_stack | default(true) | bool %}
    bind :::{{ haproxy_stats_port }} v4v6
{% else %}
    bind *:{{ haproxy_stats_port }}
{% endif %}
    mode http
    stats enable
    stats uri {{ haproxy_stats_uri }}
    stats refresh {{ haproxy_stats_refresh }}
    stats show-node
{% if admin_users is defined and admin_users | length > 0 %}
    # Authenticated service accounts created from admin list
{% for admin in admin_users %}
{% set admin_pass = admin.service_password | default(admin.password | default(haproxy_stats_password)) %}
    stats auth {{ admin.name }}:{{ admin_pass }}
{% endfor %}
{% else %}
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_password }}
{% endif %}
{% if (haproxy_stats_allowed_ips is defined and haproxy_stats_allowed_ips | length > 0) or (groups['monitoring'] is defined and groups['monitoring'] | length > 0) %}

    # Access Control: Allow only authorized IPs, CIDRs, and dynamically resolved FQDNs
    # Evaluated before services to prevent unauthorized access to stats UI or Prometheus metrics
    acl is_allowed_stats src -f /etc/haproxy/stats_whitelist.lst
{% if haproxy_stats_deny_action == 'silent-drop' %}
    http-request silent-drop unless is_allowed_stats
{% else %}
    http-request deny deny_status 403 unless is_allowed_stats
{% endif %}
{% endif %}
{% if haproxy_enable_prometheus | bool %}

    # Native Prometheus Metrics Exporter (protected by preceding ACL whitelist and auth)
    http-request use-service prometheus-exporter if { path {{ haproxy_prometheus_path }} }
{% endif %}
{% endif %}

# --- HTTP Frontend (Port {{ haproxy_bind_http_port }}) ---
frontend fe_http
{% if haproxy_enable_dual_stack | default(true) | bool %}
    bind :::{{ haproxy_bind_http_port }} v4v6
{% else %}
    bind *:{{ haproxy_bind_http_port }}
{% endif %}
    mode http
    option forwardfor

    # Let's Encrypt HTTP-01 challenge routing (proxied to Primary Certificate Issuer)
    acl is_acme_challenge path_beg /.well-known/acme-challenge/
    use_backend be_acme if is_acme_challenge

    # Redirect all normal HTTP traffic to HTTPS
    http-request redirect scheme https unless is_acme_challenge

{% set has_stats_whitelist = (haproxy_enable_stats | default(true) | bool) and ((haproxy_stats_allowed_ips is defined and haproxy_stats_allowed_ips | length > 0) or (admin_trusted_cidrs is defined and admin_trusted_cidrs | length > 0) or (groups['monitoring'] is defined and groups['monitoring'] | length > 0)) %}

# --- HTTPS Frontend (Port {{ haproxy_bind_https_port }}) ---
# SSL is decoded and terminated here across all certificates in {{ haproxy_certs_dir }}
frontend fe_https
{% if haproxy_enable_dual_stack | default(true) | bool %}
    bind :::{{ haproxy_bind_https_port }} v4v6 ssl crt {{ haproxy_certs_dir }}/{% if haproxy_enable_http2 | bool %} alpn h2,http/1.1{% endif %}
{% else %}
    bind *:{{ haproxy_bind_https_port }} ssl crt {{ haproxy_certs_dir }}/{% if haproxy_enable_http2 | bool %} alpn h2,http/1.1{% endif %}
{% endif %}
    mode http
    option forwardfor
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port %[dst_port]
{% if haproxy_enable_security_headers | bool %}

    # Security & Privacy Headers
    http-response set-header X-Content-Type-Options "nosniff"
    http-response set-header X-Frame-Options "{{ haproxy_header_frame_options }}"
    http-response set-header Referrer-Policy "{{ haproxy_header_referrer_policy }}"
{% if haproxy_enable_hsts | bool %}
    http-response set-header Strict-Transport-Security "max-age={{ haproxy_hsts_max_age }}{% if haproxy_hsts_include_subdomains | bool %}; includeSubDomains{% endif %}{% if haproxy_hsts_preload | bool %}; preload{% endif %}"
{% endif %}
{% endif %}
{% if haproxy_enable_rate_limit | bool %}

    # Volumetric Layer 7 Rate Limiting (Stick Table)
    stick-table type ip size {{ haproxy_rate_limit_table_size }} expire {{ haproxy_rate_limit_expire }} store http_req_rate({{ haproxy_rate_limit_period }})
    http-request track-sc0 src
    http-request deny deny_status {{ haproxy_rate_limit_status }} if { sc_http_req_rate(0) gt {{ haproxy_rate_limit_req_rate }} }
{% endif %}
{% if haproxy_enable_coraza_waf | default(true) | bool %}

    # Coraza Web Application Firewall (SPOE Engine & OWASP Core Rule Set)
    unique-id-format %[date()]_%[pid]_%[var(txn.id)]
    filter spoe engine coraza config /etc/haproxy/coraza-spoe.cfg
    http-request deny deny_status 403 if { var(txn.coraza.action) -m str deny }
{% endif %}

{%- set web_pools = {} -%}
{%- if groups['webservers'] is defined -%}
{%- for host in groups['webservers'] -%}
{%- set host_fqdn = hostvars[host]['external_fqdn'] | default(hostvars[host]['ansible_fqdn'] | default(host)) -%}
{%- set pool_id = hostvars[host]['backend_pool'] | default(host_fqdn) -%}
{%- if pool_id not in web_pools -%}
{%- set _ = web_pools.update({pool_id: {'fqdns': [], 'hosts': []}}) -%}
{%- endif -%}
{%- if host_fqdn not in web_pools[pool_id]['fqdns'] -%}
{%- set _ = web_pools[pool_id]['fqdns'].append(host_fqdn) -%}
{%- endif -%}
{%- set _ = web_pools[pool_id]['hosts'].append(host) -%}
{%- endfor -%}
{%- endif -%}

{% if web_pools is defined and web_pools | length > 0 %}
    # Webserver routing (supports 1:1 dedicated backends and N:1 pooled backends)
{% for pool_id, pdata in web_pools.items() %}
{% set clean_name = pool_id | regex_replace('[^a-zA-Z0-9]', '_') %}
    # Route for backend pool: {{ pool_id }} ({{ pdata.fqdns | join(', ') }})
    acl is_{{ clean_name }} hdr(host) -i {{ pdata.fqdns | join(' ') }}
    use_backend be_{{ clean_name }} if is_{{ clean_name }}
{% endfor %}
{% endif %}

{% set tp_hosts = groups['teleport_servers'] | default(groups['teleport'] | default([])) %}
{% if tp_hosts | length > 0 %}
{% for host in tp_hosts %}
{% set clean_name = host | regex_replace('[^a-zA-Z0-9]', '_') %}
{% set fqdn = hostvars[host]['external_fqdn'] | default(teleport_fqdn | default('teleport.' ~ (domain_name | default('example.com')))) %}
    # Route for Teleport Web UI / Proxy: {{ fqdn }}{% if has_stats_whitelist %} (Protected by Admin ACL){% endif %}

    acl is_{{ clean_name }} hdr(host) -i {{ fqdn }}
{% if has_stats_whitelist %}
    acl is_allowed_admin_tp src -f /etc/haproxy/stats_whitelist.lst
    http-request deny deny_status 403 if is_{{ clean_name }} !is_allowed_admin_tp
{% endif %}
    use_backend be_{{ clean_name }} if is_{{ clean_name }}
{% endfor %}
{% endif %}

{% if groups['monitoring'] is defined and groups['monitoring'] | length > 0 %}
{% for host in groups['monitoring'] %}
{% set clean_name = host | regex_replace('[^a-zA-Z0-9]', '_') %}
{% set grafana_host_fqdn = hostvars[host]['grafana_fqdn'] | default(grafana_fqdn | default('grafana.' ~ (domain_name | default('example.com')))) %}
{% set monitoring_host_fqdn = hostvars[host]['monitoring_fqdn'] | default(monitoring_fqdn | default('monitoring.' ~ (domain_name | default('example.com')))) %}
    # Route for Grafana & Monitoring UI: {{ grafana_host_fqdn }} / {{ monitoring_host_fqdn }}{% if has_stats_whitelist %} (Protected by Admin ACL){% endif %}

    acl is_{{ clean_name }} hdr(host) -i {{ grafana_host_fqdn }} {{ monitoring_host_fqdn }}
{% if has_stats_whitelist %}
    acl is_allowed_admin_mon src -f /etc/haproxy/stats_whitelist.lst
    http-request deny deny_status 403 if is_{{ clean_name }} !is_allowed_admin_mon
{% endif %}
    use_backend be_{{ clean_name }} if is_{{ clean_name }}
{% endfor %}
{% endif %}

{% set rmq_hosts = groups['rabbitmq_servers'] | default(groups['rabbitmq'] | default([])) %}
{% if rmq_hosts | length > 0 %}
{% for host in rmq_hosts %}
{% set clean_name = host | regex_replace('[^a-zA-Z0-9]', '_') %}
{% set rmq_host_fqdn = hostvars[host]['rabbitmq_mgmt_fqdn'] | default(rabbitmq_mgmt_fqdn | default('mq.' ~ (domain_name | default('example.com')))) %}
    # Route for RabbitMQ Management UI: {{ rmq_host_fqdn }}{% if has_stats_whitelist %} (Protected by Admin ACL){% endif %}

    acl is_{{ clean_name }}_rmq hdr(host) -i {{ rmq_host_fqdn }}
{% if has_stats_whitelist %}
    acl is_allowed_admin_rmq src -f /etc/haproxy/stats_whitelist.lst
    http-request deny deny_status 403 if is_{{ clean_name }}_rmq !is_allowed_admin_rmq
{% endif %}
    use_backend be_{{ clean_name }}_rmq if is_{{ clean_name }}_rmq
{% endfor %}
{% endif %}

{% set ipa_hosts = groups['freeipa_servers'] | default([]) %}
{% if ipa_hosts | length > 0 %}
{% for host in ipa_hosts %}
{% set clean_name = host | regex_replace('[^a-zA-Z0-9]', '_') %}
{% set ipa_host_fqdn = hostvars[host]['external_fqdn'] | default(hostvars[host]['freeipa_server_fqdn'] | default(freeipa_server_fqdn | default('ipa.' ~ (freeipa_domain | default(domain_name | default('example.com')))))) %}
    # Route for FreeIPA Identity Web UI: {{ ipa_host_fqdn }}{% if has_stats_whitelist %} (Protected by Admin ACL){% endif %}

    acl is_{{ clean_name }}_ipa hdr(host) -i {{ ipa_host_fqdn }}
{% if has_stats_whitelist %}
    acl is_allowed_admin_ipa src -f /etc/haproxy/stats_whitelist.lst
    http-request deny deny_status 403 if is_{{ clean_name }}_ipa !is_allowed_admin_ipa
{% endif %}
    use_backend be_{{ clean_name }}_ipa if is_{{ clean_name }}_ipa
{% endfor %}
{% endif %}

    default_backend be_default_404

# --- ACME Standalone Challenge Backend ---
# Forwards Let's Encrypt HTTP-01 challenges according to cluster line of succession.
# The primary proxy (rank 0) handles challenges normally; standby replicas act as backup
# in succession order if higher-ranking proxies are offline during renewal.
backend be_acme
    mode http
{% if groups['proxies'] is defined %}
{% for p in groups['proxies'] %}
{% set p_clean = p | regex_replace('[^a-zA-Z0-9]', '_') %}
{% set is_backup = not loop.first %}
{% if p == inventory_hostname %}
    server acme_{{ p_clean }} 127.0.0.1:{{ acme_standalone_port }} check inter 1s fall 2 rise 2 {% if is_backup %}backup{% endif %}
{% else %}
    server acme_{{ p_clean }} {{ hostvars[p]['internal_ip'] | default(hostvars[p]['ansible_host'] | default(p)) }}:{{ acme_standalone_port }} check inter 1s fall 2 rise 2 {% if is_backup %}backup{% endif %}
{% endif %}
{% endfor %}
{% endif %}

# --- Dynamic Backend Webservers (1:1 dedicated or N:1 load-balanced pools) ---
{% if web_pools is defined and web_pools | length > 0 %}
{% for pool_id, pdata in web_pools.items() %}
{% set clean_name = pool_id | regex_replace('[^a-zA-Z0-9]', '_') %}
{% set primary_fqdn = pdata.fqdns[0] %}
{% set first_host = pdata.hosts[0] %}
{% set balance_algo = hostvars[first_host]['backend_balance'] | default(haproxy_balance_algorithm | default('roundrobin')) %}
{% set use_cookie = hostvars[first_host]['backend_cookie_persistence'] | default(haproxy_enable_cookie_persistence | default(false)) | bool %}
backend be_{{ clean_name }}
    mode http
    balance {{ balance_algo }}
{% if use_cookie %}
    cookie SERVERID insert indirect nocache
{% endif %}
    option forwardfor
    http-request set-header Host {{ primary_fqdn }}
{% if haproxy_backend_http_check | bool %}
    option httpchk GET / HTTP/1.1\r\nHost:\ {{ primary_fqdn }}
    http-check expect rstatus (2..|3..)
{% endif %}
{% for host in pdata.hosts %}
{% set target_ip = hostvars[host]['internal_ip'] | default(hostvars[host]['ansible_host'] | default(host)) %}
{% set target_port = 443 if (haproxy_backend_ssl | default(false) | bool) else 80 %}
{% if haproxy_backend_ssl | default(false) | bool %}
{% if haproxy_backend_ssl_verify | default('required') == 'required' %}
{% set ssl_opts = 'ssl verify required ca-file ' ~ haproxy_backend_ca_file %}
{% else %}
{% set ssl_opts = 'ssl verify none' %}
{% endif %}
{% else %}
{% set ssl_opts = '' %}
{% endif %}
{% set cookie_opt = ('cookie ' ~ host) if use_cookie else '' %}
{% if haproxy_backend_http_check | bool %}
    server {{ host }} {{ target_ip }}:{{ target_port }}{% if ssl_opts %} {{ ssl_opts }}{% endif %}{% if cookie_opt %} {{ cookie_opt }}{% endif %} check inter {{ haproxy_check_inter }} fall {{ haproxy_check_fall }} rise {{ haproxy_check_rise }}
{% else %}
    server {{ host }} {{ target_ip }}:{{ target_port }}{% if ssl_opts %} {{ ssl_opts }}{% endif %}{% if cookie_opt %} {{ cookie_opt }}{% endif %} check
{% endif %}
{% endfor %}

{% endfor %}
{% endif %}

# --- Fallback 404 Backend ---
backend be_default_404
    mode http
    errorfile 503 /etc/haproxy/errors/404.http

# --- Dedicated Teleport Web UI / Proxy Backends ---
{% set tp_hosts = groups['teleport_servers'] | default(groups['teleport'] | default([])) %}
{% if tp_hosts | length > 0 %}
{% for host in tp_hosts %}
{% set clean_name = host | regex_replace('[^a-zA-Z0-9]', '_') %}
{% set target_ip = hostvars[host]['internal_ip'] | default(hostvars[host]['ansible_host'] | default(host)) %}
backend be_{{ clean_name }}
    mode http
    balance roundrobin
    option forwardfor
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port 443
    # Teleport Web UI operates on internal port 3080 over TLS
    server {{ host }} {{ target_ip }}:3080 ssl verify none check inter 5s fall 3 rise 2
{% endfor %}
{% endif %}

# --- Dedicated Monitoring & Grafana UI Backends ---
{% if groups['monitoring'] is defined and groups['monitoring'] | length > 0 %}
{% for host in groups['monitoring'] %}
{% set clean_name = host | regex_replace('[^a-zA-Z0-9]', '_') %}
{% set target_ip = hostvars[host]['internal_ip'] | default(hostvars[host]['ansible_host'] | default(host)) %}
{% set grafana_host_fqdn = hostvars[host]['grafana_fqdn'] | default(grafana_fqdn | default('grafana.' ~ (domain_name | default('example.com')))) %}
{% set grafana_tls = hostvars[host]['grafana_enable_tls'] | default(enable_internal_tls | default(false)) | bool %}
backend be_{{ clean_name }}
    mode http
    balance roundrobin
    option forwardfor
    http-request set-header Host {{ grafana_host_fqdn }}
    http-request set-header X-Forwarded-Proto https
    # Grafana Web UI operates on internal port {{ hostvars[host]['grafana_port'] | default(3000) }} ({{ 'HTTPS' if grafana_tls else 'HTTP' }})
{% if grafana_tls %}
{% if haproxy_backend_ssl_verify | default('required') == 'required' %}
    server {{ host }} {{ target_ip }}:{{ hostvars[host]['grafana_port'] | default(3000) }} ssl verify required ca-file {{ haproxy_backend_ca_file }} check inter 5s fall 3 rise 2
{% else %}
    server {{ host }} {{ target_ip }}:{{ hostvars[host]['grafana_port'] | default(3000) }} ssl verify none check inter 5s fall 3 rise 2
{% endif %}
{% else %}
    server {{ host }} {{ target_ip }}:{{ hostvars[host]['grafana_port'] | default(3000) }} check inter 5s fall 3 rise 2
{% endif %}
{% endfor %}
{% endif %}

# --- Dedicated RabbitMQ Management UI Backends ---
{% set rmq_hosts = groups['rabbitmq_servers'] | default(groups['rabbitmq'] | default([])) %}
{% if rmq_hosts | length > 0 %}
{% for host in rmq_hosts %}
{% set clean_name = host | regex_replace('[^a-zA-Z0-9]', '_') %}
{% set target_ip = hostvars[host]['internal_ip'] | default(hostvars[host]['ansible_host'] | default(host)) %}
{% set target_port = hostvars[host]['rabbitmq_mgmt_port'] | default(15672) %}
backend be_{{ clean_name }}_rmq
    mode http
    balance roundrobin
    option forwardfor
    http-request set-header X-Forwarded-Proto https
    # RabbitMQ Management Web UI operates on internal port 15672
    server {{ host }} {{ target_ip }}:{{ target_port }} check inter 5s fall 3 rise 2
{% endfor %}
{% endif %}

# --- Dedicated FreeIPA Identity Web UI Backends ---
{% set ipa_hosts = groups['freeipa_servers'] | default([]) %}
{% if ipa_hosts | length > 0 %}
{% for host in ipa_hosts %}
{% set clean_name = host | regex_replace('[^a-zA-Z0-9]', '_') %}
{% set target_ip = hostvars[host]['internal_ip'] | default(hostvars[host]['ansible_host'] | default(host)) %}
{% set ipa_host_fqdn = hostvars[host]['external_fqdn'] | default(hostvars[host]['freeipa_server_fqdn'] | default(freeipa_server_fqdn | default('ipa.' ~ (freeipa_domain | default(domain_name | default('example.com')))))) %}
backend be_{{ clean_name }}_ipa
    mode http
    balance roundrobin
    option forwardfor
    http-request set-header Host {{ ipa_host_fqdn }}
    http-request set-header X-Forwarded-Proto https
    # FreeIPA Web UI listens on HTTPS port 443 (Dogtag PKI cert)
    server {{ host }} {{ target_ip }}:443 ssl verify none check inter 5s fall 3 rise 2
{% endfor %}
{% endif %}

# --- Dedicated Teleport SSH Proxy Frontend (Port 3023 TCP) ---
{% set tp_hosts = groups['teleport_servers'] | default(groups['teleport'] | default([])) %}
{% if tp_hosts | length > 0 %}
frontend fe_teleport_ssh
{% if haproxy_enable_dual_stack | default(true) | bool %}
    bind :::3023 v4v6
{% else %}
    bind *:3023
{% endif %}
    mode tcp
    option tcplog
    timeout client 1h
{% if has_stats_whitelist %}
    acl is_allowed_admin_tcp src -f /etc/haproxy/stats_whitelist.lst
    tcp-request connection reject unless is_allowed_admin_tcp
{% endif %}
    default_backend be_teleport_ssh

backend be_teleport_ssh
    mode tcp
    timeout server 1h
    timeout connect 5s
    server {{ tp_hosts[0] }} {{ hostvars[tp_hosts[0]]['internal_ip'] | default(hostvars[tp_hosts[0]]['ansible_host'] | default(tp_hosts[0])) }}:3023 check
{% endif %}

{% if haproxy_enable_coraza_waf | default(true) | bool %}
# --- Coraza SPOA Backend ---
backend be_coraza
    mode tcp
    balance roundrobin
    timeout connect 5s
    timeout server 30s
    server coraza_agent {{ coraza_spoa_bind | default('127.0.0.1') }}:{{ coraza_spoa_port | default(9000) }} check
{% endif %}
