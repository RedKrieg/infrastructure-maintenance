#!/usr/bin/env bash
# ==============================================================================
# HAProxy Certificate Synchronization Script
# Managed by Ansible - Executed on certificate renewal across proxies
# Synchronizes renewed certificates to all peer proxies in the cluster
# ==============================================================================
set -u

LOG_FILE="/var/log/haproxy-cert-sync.log"
CERTS_DIR="{{ haproxy_certs_dir }}"
SSH_KEY="/root/.ssh/id_ed25519_certsync"
ACME_DIR="{{ acme_sh_install_dir }}"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [cert-sync] $*" | tee -a "$LOG_FILE"
}

log "Starting cluster certificate synchronization from $(hostname)..."

# 1. Reload local HAProxy first
if systemctl is-active --quiet haproxy; then
    if systemctl reload haproxy; then
        log "Reloaded local HAProxy on $(hostname)"
    else
        log "ERROR: Failed to reload local HAProxy on $(hostname)"
    fi
fi

# 2. Iterate through all peer proxies and mirror certificates
{% if groups['proxies'] is defined %}
{% for proxy in groups['proxies'] %}
{% if proxy != inventory_hostname %}
PEER_IP="{{ hostvars[proxy]['ansible_host'] | default(proxy) }}"
log "Syncing certificates to peer proxy: {{ proxy }} (${PEER_IP})..."

if rsync -avz --delete \
    -e "ssh -i ${SSH_KEY} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 -o BatchMode=yes" \
    "${CERTS_DIR}/" "root@${PEER_IP}:${CERTS_DIR}/" >> "$LOG_FILE" 2>&1 && \
   ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 -o BatchMode=yes \
    "root@${PEER_IP}" "systemctl reload haproxy" >> "$LOG_FILE" 2>&1; then
    log "SUCCESS: Synced and reloaded HAProxy on {{ proxy }} (${PEER_IP})"

    # Sync acme.sh domain directories if they exist locally
    {% for host in groups['webservers'] | default([]) %}
    {% set fqdn = hostvars[host]['external_fqdn'] | default(hostvars[host]['ansible_fqdn'] | default(host)) %}
    if [ -d "${ACME_DIR}/{{ fqdn }}_ecc" ]; then
        rsync -avz \
            -e "ssh -i ${SSH_KEY} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 -o BatchMode=yes" \
            "${ACME_DIR}/{{ fqdn }}_ecc/" "root@${PEER_IP}:${ACME_DIR}/{{ fqdn }}_ecc/" >> "$LOG_FILE" 2>&1 || true
    fi
    {% endfor %}
else
    log "WARNING: Could not sync certificates to {{ proxy }} (${PEER_IP}). Host may be unreachable or in maintenance."
fi
{% endif %}
{% endfor %}
{% endif %}

log "Cluster certificate synchronization completed."
