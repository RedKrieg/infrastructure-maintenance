# ==============================================================================
# HAProxy Cluster Scripts & ACME Watchdog Logrotate Configuration
# Managed by Ansible
# ==============================================================================

/var/log/haproxy-*.log
/var/log/acme-*.log
{
    weekly
    rotate {{ haproxy_logrotate_rotate | default(8) }}
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0640 root root
}
