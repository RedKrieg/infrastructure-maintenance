# ==============================================================================
# HAProxy Cluster Scripts & ACME Watchdog Logrotate Configuration
# Managed by Ansible
# ==============================================================================

/var/log/haproxy-*.log
/var/log/acme-*.log
{
    {{ haproxy_logrotate_interval | default('daily') }}
    rotate {{ haproxy_logrotate_rotate | default(60) }}
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0640 root root
}
