# ==============================================================================
# Nginx Virtual Host for {{ external_fqdn }}
# Managed by Ansible - Frontend SSL is terminated on HAProxy proxies
# ==============================================================================

server {
    listen 80;
    listen [::]:80;

    server_name {{ external_fqdn }};

    root {{ webserver_root_dir }};
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }
}
