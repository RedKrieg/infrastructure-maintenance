# Managed by Ansible - Generic 404 catch-all default server block
# Any visitor connecting via direct IP, unconfigured domain, or disabled site receives a generic 404.

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;

    location / {
        default_type text/plain;
        return 404 "404 Not Found\n";
    }
}
