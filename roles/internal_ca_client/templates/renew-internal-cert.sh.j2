#!/usr/bin/env bash
# ==============================================================================
# Automated Fleet Internal TLS Certificate Renewal Script
# Managed by Ansible - Executed across all cluster nodes via systemd timer
# Enrolls node with Cluster Internal CA and maintains zero-trust node certificates
# ==============================================================================
set -u

LOG_FILE="/var/log/internal-cert-renewal.log"
CERT_DIR="{{ internal_ssl_cert_dir }}"
CERT_FILE="{{ internal_ssl_cert }}"
KEY_FILE="{{ internal_ssl_key }}"
CSR_FILE="{{ internal_ssl_csr }}"
CA_FILE="{{ internal_ssl_ca_cert }}"
THRESHOLD_DAYS={{ internal_cert_renewal_threshold_days | default(14) }}
THRESHOLD_SECONDS=$(( THRESHOLD_DAYS * 86400 ))
AUTH_TOKEN="{{ internal_ca_token }}"
SIGNER_PORT={{ internal_ca_signer_port | default(8444) }}
CURVE="{{ internal_ssl_curve | default('secp384r1') }}"
DIGEST="{{ internal_ssl_digest | default('sha384') }}"
PROM_DIR="/var/lib/prometheus/node-exporter"

NODE_IP="{{ internal_ip | default(ansible_default_ipv4.address | default(ansible_host)) }}"
NODE_HOSTNAME="{{ inventory_hostname }}"
NODE_FQDN="{{ external_fqdn | default(inventory_hostname) }}"

# Ingress proxies in rank-based line of succession order
PROXIES=(
{% if groups['proxies'] is defined %}
{% for proxy in groups['proxies'] %}
    "{{ proxy }}:{{ hostvars[proxy]['internal_ip'] | default(hostvars[proxy]['ansible_host'] | default(proxy)) }}"
{% endfor %}
{% endif %}
)

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [internal-cert-renew] $*" | tee -a "$LOG_FILE"
}

mkdir -p "$CERT_DIR"
[ -d "$PROM_DIR" ] || mkdir -p "$PROM_DIR"

# 1. Inspect existing certificate if present
NEED_RENEWAL=0
if [ -f "$CERT_FILE" ]; then
    EXPIRY_DATE=$(openssl x509 -enddate -noout -in "$CERT_FILE" | cut -d= -f2)
    EXPIRY_EPOCH=$(date -d "$EXPIRY_DATE" +%s 2>/dev/null || date -j -f "%b %d %T %Y %Z" "$EXPIRY_DATE" +%s)
    NOW_EPOCH=$(date +%s)
    REMAINING_SECONDS=$(( EXPIRY_EPOCH - NOW_EPOCH ))
    REMAINING_DAYS=$(( REMAINING_SECONDS / 86400 ))

    # Export Prometheus metric
    cat <<EOF > "${PROM_DIR}/internal_leaf_expiry.prom.$$"
# HELP x509_cert_expiry_timestamp_seconds Unix timestamp when the X.509 certificate expires
# TYPE x509_cert_expiry_timestamp_seconds gauge
x509_cert_expiry_timestamp_seconds{cert_name="internal_node",cert_path="${CERT_FILE}",role="leaf"} ${EXPIRY_EPOCH}
EOF
    mv "${PROM_DIR}/internal_leaf_expiry.prom.$$" "${PROM_DIR}/internal_leaf_expiry.prom"

    log "Current internal certificate valid until ${EXPIRY_DATE} (${REMAINING_DAYS} days remaining; renewal threshold: ${THRESHOLD_DAYS}d)."

    if [ "$REMAINING_SECONDS" -le "$THRESHOLD_SECONDS" ]; then
        log "Certificate is within the ${THRESHOLD_DAYS}-day threshold. Renewal triggered."
        NEED_RENEWAL=1
    fi
else
    log "No existing certificate found at ${CERT_FILE}. Initial issuance required."
    NEED_RENEWAL=1
fi

if [ "$#" -gt 0 ] && [ "$1" == "--force" ]; then
    log "Force renewal flag specified."
    NEED_RENEWAL=1
fi

if [ "$NEED_RENEWAL" -eq 0 ]; then
    log "Certificate valid and above renewal threshold. Exiting cleanly."
    exit 0
fi

# 2. Ensure private key exists
if [ ! -f "$KEY_FILE" ]; then
    log "Generating new ECDSA P-384 (${CURVE}) private key..."
    openssl ecparam -name "${CURVE}" -genkey -noout -out "$KEY_FILE" >> "$LOG_FILE" 2>&1
    chmod 0640 "$KEY_FILE"
    chgrp ssl-cert "$KEY_FILE" 2>/dev/null || true
fi

# 3. Generate CSR with Subject Alternative Names (SANs)
TMP_CNF=$(mktemp)
cat <<EOF > "$TMP_CNF"
[req]
distinguished_name = req_dn
req_extensions = v3_req
prompt = no

[req_dn]
CN = ${NODE_FQDN}
O = InternalCluster
OU = FleetNodes

[v3_req]
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyAgreement
extendedKeyUsage = serverAuth, clientAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = ${NODE_FQDN}
DNS.2 = ${NODE_HOSTNAME}
IP.1 = ${NODE_IP}
IP.2 = 127.0.0.1
EOF

openssl req -new -${DIGEST} -key "$KEY_FILE" -out "$CSR_FILE" -config "$TMP_CNF" >> "$LOG_FILE" 2>&1
rm -f "$TMP_CNF"

CSR_CONTENT=$(cat "$CSR_FILE")

# 4. Request signature from proxies using rank-based succession failover
SIGN_SUCCESS=0
for peer in "${PROXIES[@]}"; do
    [ -z "$peer" ] && continue
    p_name="${peer%%:*}"
    p_ip="${peer##*:}"

    log "Attempting certificate signature via proxy: ${p_name} (${p_ip}:${SIGNER_PORT})..."

    # Check signer reachability
    if ! curl -s --connect-timeout 3 -m 5 "http://${p_ip}:${SIGNER_PORT}/health" >/dev/null 2>&1; then
        log "WARNING: Proxy ${p_name} (${p_ip}) is unreachable or signer service is down. Falling back to next proxy..."
        continue
    fi

    # Submit JSON signing request
    JSON_PAYLOAD=$(python3 -c "import json, sys; print(json.dumps({'csr': sys.stdin.read(), 'hostname': '${NODE_HOSTNAME}', 'token': '${AUTH_TOKEN}'}))" <<EOF
${CSR_CONTENT}
EOF
)

    RESPONSE=$(curl -s --connect-timeout 5 -m 10 -X POST \
        -H "Content-Type: application/json" \
        -d "${JSON_PAYLOAD}" \
        "http://${p_ip}:${SIGNER_PORT}/sign" 2>/dev/null || echo "")

    if echo "$RESPONSE" | grep -q '"certificate"'; then
        log "SUCCESS: Received signed certificate from proxy ${p_name} (${p_ip}). Installing..."

        # Extract certificate PEM from JSON response
        python3 -c "import json, sys; data=json.loads(sys.stdin.read()); print(data.get('certificate', ''))" <<< "$RESPONSE" > "${CERT_FILE}.new"

        if [ -s "${CERT_FILE}.new" ] && openssl x509 -noout -in "${CERT_FILE}.new" >/dev/null 2>&1; then
            mv "${CERT_FILE}.new" "$CERT_FILE"
            chmod 0644 "$CERT_FILE"
            chown root:root "$CERT_FILE"

            # Fetch and install Internal CA root certificate
            curl -s --connect-timeout 3 -m 5 "http://${p_ip}:${SIGNER_PORT}/ca.crt" -o "${CA_FILE}.new" 2>/dev/null || true
            if [ -s "${CA_FILE}.new" ]; then
                mv "${CA_FILE}.new" "$CA_FILE"
                chmod 0644 "$CA_FILE"
                cp -f "$CA_FILE" /usr/local/share/ca-certificates/cluster-internal-ca.crt 2>/dev/null || true
                update-ca-certificates >/dev/null 2>&1 || true
            fi

            # Update Prometheus metric
            NEW_EXPIRY=$(openssl x509 -enddate -noout -in "$CERT_FILE" | cut -d= -f2)
            NEW_EPOCH=$(date -d "$NEW_EXPIRY" +%s 2>/dev/null || date -j -f "%b %d %T %Y %Z" "$NEW_EXPIRY" +%s)
            cat <<EOF > "${PROM_DIR}/internal_leaf_expiry.prom.$$"
# HELP x509_cert_expiry_timestamp_seconds Unix timestamp when the X.509 certificate expires
# TYPE x509_cert_expiry_timestamp_seconds gauge
x509_cert_expiry_timestamp_seconds{cert_name="internal_node",cert_path="${CERT_FILE}",role="leaf"} ${NEW_EPOCH}
EOF
            mv "${PROM_DIR}/internal_leaf_expiry.prom.$$" "${PROM_DIR}/internal_leaf_expiry.prom"

            # Gracefully refresh any running services using the certificate
            for svc in nginx rsyslog prometheus-node-exporter postgresql redis-server rabbitmq-server grafana-server; do
                if systemctl is-active --quiet "$svc"; then
                    systemctl reload "$svc" 2>/dev/null || systemctl restart "$svc" 2>/dev/null || true
                    log "Refreshed service $svc with updated certificate."
                fi
            done

            SIGN_SUCCESS=1
            break
        else
            log "ERROR: Invalid certificate data received from proxy ${p_name}."
            rm -f "${CERT_FILE}.new"
        fi
    else
        log "WARNING: Proxy ${p_name} (${p_ip}) rejected signing request: ${RESPONSE}. Falling back..."
    fi
done

if [ "$SIGN_SUCCESS" -eq 1 ]; then
    log "Internal certificate renewal completed successfully."
    exit 0
else
    log "CRITICAL: All ingress proxies in the succession line failed to sign internal certificate!"
    exit 1
fi
