# ==============================================================================
# Google Cloud Platform (GCP) Compute Engine Inventory
# Generated automatically by examples/provisioning/provision_gcp.yml
# Frontends placed across distinct GCP Zones (e.g., us-central1-a, 1-b, 1-c)
# Behind a Regional External TCP/UDP Passthrough Network Load Balancer
# ==============================================================================

[proxies]
{% for inst in gcp_instances if inst.group == 'proxies' %}
{{ inst.name }} ansible_host={{ inst.ip }} zone={{ inst.zone }}
{% endfor %}

[webservers]
{% for inst in gcp_instances if inst.group == 'webservers' %}
{{ inst.name }} ansible_host={{ inst.ip }} external_fqdn={{ inst.external_fqdn }} zone={{ inst.zone }}
{% endfor %}

[monitoring]
{% for inst in gcp_instances if inst.group == 'monitoring' %}
{{ inst.name }} ansible_host={{ inst.ip }} zone={{ inst.zone }}
{% endfor %}

[teleport_servers]
{% for inst in gcp_instances if inst.group == 'teleport_servers' %}
{{ inst.name }} ansible_host={{ inst.ip }} zone={{ inst.zone }}
{% endfor %}

[freeipa_servers]
{% for inst in gcp_instances if inst.group == 'freeipa_servers' %}
{{ inst.name }} ansible_host={{ inst.ip }} zone={{ inst.zone }}
{% endfor %}

[databases]
{% for inst in gcp_instances if inst.group == 'databases' %}
{{ inst.name }} ansible_host={{ inst.ip }} zone={{ inst.zone }}
{% endfor %}

[redis_servers]
{% for inst in gcp_instances if inst.group == 'redis_servers' %}
{{ inst.name }} ansible_host={{ inst.ip }} zone={{ inst.zone }}
{% endfor %}

[rabbitmq_servers]
{% for inst in gcp_instances if inst.group == 'rabbitmq_servers' %}
{{ inst.name }} ansible_host={{ inst.ip }} zone={{ inst.zone }}
{% endfor %}

[headless_nodes:children]
proxies
webservers
monitoring
teleport_servers
freeipa_servers
databases
redis_servers
rabbitmq_servers

[headless_nodes:vars]
ansible_user={{ gcp_ssh_user }}
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
