# ==============================================================================
# Oracle Cloud Infrastructure (OCI) Example Inventory
# Generated automatically by examples/provisioning/provision_oci.yml
# Frontends placed across distinct Fault Domains (e.g., FD-1, FD-2, FD-3)
# Behind an OCI Network Load Balancer (NLB) with TCP 80/443 listeners
# ==============================================================================

[proxies]
{% for inst in oci_instances if inst.group == 'proxies' %}
{{ inst.name }} ansible_host={{ inst.ip }} fault_domain={{ inst.fault_domain }}
{% endfor %}

[webservers]
{% for inst in oci_instances if inst.group == 'webservers' %}
{{ inst.name }} ansible_host={{ inst.ip }} external_fqdn={{ inst.external_fqdn }} fault_domain={{ inst.fault_domain }}
{% endfor %}

[monitoring]
{% for inst in oci_instances if inst.group == 'monitoring' %}
{{ inst.name }} ansible_host={{ inst.ip }} fault_domain={{ inst.fault_domain }}
{% endfor %}

[teleport_servers]
{% for inst in oci_instances if inst.group == 'teleport_servers' %}
{{ inst.name }} ansible_host={{ inst.ip }} fault_domain={{ inst.fault_domain }}
{% endfor %}

[freeipa_servers]
{% for inst in oci_instances if inst.group == 'freeipa_servers' %}
{{ inst.name }} ansible_host={{ inst.ip }} fault_domain={{ inst.fault_domain }}
{% endfor %}

[databases]
{% for inst in oci_instances if inst.group == 'databases' %}
{{ inst.name }} ansible_host={{ inst.ip }} fault_domain={{ inst.fault_domain }}
{% endfor %}

[redis_servers]
{% for inst in oci_instances if inst.group == 'redis_servers' %}
{{ inst.name }} ansible_host={{ inst.ip }} fault_domain={{ inst.fault_domain }}
{% endfor %}

[rabbitmq_servers]
{% for inst in oci_instances if inst.group == 'rabbitmq_servers' %}
{{ inst.name }} ansible_host={{ inst.ip }} fault_domain={{ inst.fault_domain }}
{% endfor %}

[headless_nodes:children]
proxies
webservers
monitoring
teleport_servers
freeipa_servers
databases
redis_servers
rabbitmq_servers

[headless_nodes:vars]
ansible_user={{ oci_ssh_user }}
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
